*.app/
*.o
*.a
*.dylib

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json

# IDE
.vscode/
.idea/
*.xcodeproj/
*.xcworkspace/

# OS
.DS_Store

# Coverage
*.profraw
*.profdata
*.gcov
coverage/

# Logs and artifacts
*.log
*.zip
*.txt
!CMakeLists.txt
!scripts/file-size-baseline.txt
!scripts/function-size-baseline.txt
.claudignore
.gemini/
.claude/settings.local.json
worktrees/
build-asan/
build-app/
build-harness/
build-release/
build-test/
# Catch-all for ad hoc out-of-tree build dirs (build-verify/, build-<branch>/, …)
build-*/

# ccache directory — CI pins CCACHE_DIR to <workspace>/.ccache (.github/workflows/ci.yml) so the
# actions/cache path can never drift from ccache's per-OS default; keep it out of the tree.
.ccache/

# Scratch logs/output for local verification runs (e.g. gtest_list_tests snapshots).
.buildlogs/
