     static bool isValidPeer (const ComponentPeer* peer) noexcept;
 
+    /** When true, the macOS and Windows peers' contains() no longer ask the OS whether another window
+        covers the point, so a window that is behind others (or behind another app) still hit-tests as
+        its own. Set once at startup by an app's automation mode; false (stock behaviour) otherwise. */
+    static inline bool ignoreWindowOrderForHitTests = false;
+
+    /** When true (macOS only; other platforms ignore it), every window the process creates after this is set is
+        invisible and transparent to the user's mouse (alpha 0, ignores mouse events, no shadow), setAlpha cannot make
+        it visible, and nothing in the peer activates the application. The windows are still ordered in and rendered,
+        so a script that drives them through the ComponentPeer and reads their pixels works unchanged. Set once at
+        startup by an app's (or the test suite's) automation mode, before the first window; false otherwise. */
+    static inline bool hideWindowsForAutomation = false;
