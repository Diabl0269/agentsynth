+void VST3PluginFormat::setHostContextMenuExtension (AudioPluginInstance& instance, HostContextMenuExtension extension)
+{
+    if (auto* vst3 = dynamic_cast<VST3PluginInstance*> (&instance))
+        vst3->setHostContextMenuExtension (std::move (extension));
+}
