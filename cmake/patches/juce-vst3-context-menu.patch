diff --git a/modules/juce_audio_processors/format_types/juce_VST3PluginFormat.h b/modules/juce_audio_processors/format_types/juce_VST3PluginFormat.h
index c8eab65..37a9e67 100644
--- a/modules/juce_audio_processors/format_types/juce_VST3PluginFormat.h
+++ b/modules/juce_audio_processors/format_types/juce_VST3PluginFormat.h
@@ -44,6 +44,19 @@ namespace juce
 */
 class JUCE_API VST3PluginFormat : public VST3PluginFormatHeadless
 {
+public:
+    /** Adds items to the context menu a hosted plugin requests for one of its parameters
+        (IComponentHandler3::createContextMenu with a ParamID).
+
+        The callback gets the VST3 ParamID and a PopupMenu to fill. It runs on the message thread
+        when the menu is about to show; every item it adds is shown below the plugin's own items and
+        carries its own PopupMenu::Item::action, which JUCE runs on the message thread after the menu
+        closes. An instance that is not a VST3 plugin is ignored. An empty function clears the hook.
+    */
+    using HostContextMenuExtension = std::function<void (uint32, PopupMenu&)>;
+    static void setHostContextMenuExtension (AudioPluginInstance&, HostContextMenuExtension);
+
+private:
     void createPluginInstance (const PluginDescription&, double, int, PluginCreationCallback) override;
 };
 
